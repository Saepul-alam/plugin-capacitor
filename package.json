{
  "name": "@al/pluginsecure",
  "version": "1.0.21",
  "description": "Fake GPS detection + verified camera capture for Capacitor apps",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "files": [
    "dist/",
    "src/",
    "scripts/",
    "capacitor-plugin.json",
    "AlPluginsecure.podspec"
  ],
  "scripts": {
    "build": "rm -rf dist && npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.json --module commonjs --outDir dist/cjs --declaration false --declarationMap false",
    "watch": "tsc --watch",
    "prepare": "npm run build"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "security",
    "gps",
    "camera",
    "fake-gps",
    "anti-spoofing"
  ],
  "author": "Saepul Alam <saepul.alam@example.com>",
  "license": "MIT",
  "peerDependencies": {
    "@capacitor/core": ">=2.0.0 || >=3.0.0"
  },
  "devDependencies": {
    "typescript": "^4.5.0",
    "@capacitor/core": "^2.5.0",
    "@types/node": "^16.0.0"
  },
  "capacitor": {
    "ios": {
      "src": "src/ios"
    },
    "android": {
      "src": "src/android"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Saepul-alam/plugin-capacitor.git"
  },
  "bugs": {
    "url": "https://github.com/Saepul-alam/plugin-capacitor/issues"
  },
  "homepage": "https://github.com/Saepul-alam/plugin-capacitor#readme"
}
